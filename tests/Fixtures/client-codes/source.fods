<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:of="urn:oasis:names:tc:opendocument:xmlns:of:1.2" office:version="1.2" office:mimetype="application/vnd.oasis.opendocument.spreadsheet">
 <office:body>
  <office:spreadsheet>
   <table:table table:name="Коды">
    <table:table-row><table:table-cell office:value-type="string"><text:p>Коды товаров ООО Сантехторг</text:p></table:table-cell></table:table-row>
    <table:table-row><table:table-cell/></table:table-row>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>Наш артикул</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>Код клиента</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>Примечание</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>GR-001</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>00777</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>текст с ведущими нулями</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell office:value-type="float" office:value="12345"><text:p>12345</text:p></table:table-cell>
     <table:table-cell office:value-type="float" office:value="5"><text:p>5</text:p></table:table-cell>
    </table:table-row>
    <table:table-row><table:table-cell/></table:table-row>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>HG-002</text:p></table:table-cell>
     <table:table-cell table:formula="of:=CONCATENATE(&quot;HG&quot;;&quot;-&quot;;&quot;B1&quot;)" office:value-type="string" office:string-value="HG-B1"><text:p>HG-B1</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>формула</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p> OR-003 </text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>Код-Ё</text:p></table:table-cell>
    </table:table-row>
   </table:table>
   <table:table table:name="Прочее">
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>Наш артикул</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>Код клиента</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>GR-001</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>ВТОРОЙ-ЛИСТ</text:p></table:table-cell>
    </table:table-row>
   </table:table>
  </office:spreadsheet>
 </office:body>
</office:document>
