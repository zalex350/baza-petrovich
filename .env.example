APP_NAME=smesitel.by
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker (docker-compose.yml): контейнер mysql создаёт базу и пользователя из этих значений
# при первом запуске. Пароли задать до первого docker-compose up — без них compose не стартует.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=smesitel
DB_USERNAME=smesitel
DB_PASSWORD=
# Только для контейнера mysql, приложению не нужен
DB_ROOT_PASSWORD=

# Порты на хосте (docker-compose.yml)
APP_PORT=8090
FORWARD_DB_PORT=3307

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Локально — Mailpit (сервис mailpit в docker-compose.yml): письма в http://localhost:8025.
# На стенде — MAIL_MAILER=log (docs/STAGING.md «Логи и письма»).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@smesitel.by"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Витрина: индикатор наличия x-stock (config/shop.php) — остаток ≥ MANY: «Много»,
# больше FEW: «Мало», 1…FEW: «N шт.»
SHOP_STOCK_MANY=10
SHOP_STOCK_FEW=3
